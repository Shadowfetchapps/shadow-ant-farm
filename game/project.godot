; Shadow Ant Farm — Godot 4.7.2-stable (pinned)
config_version=5

[application]

config/name="Shadow Ant Farm"
config/description="A photorealistic glass ant farm for long, unattended streams."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="shadow-ant-farm"
run/low_processor_mode=false
run/max_fps=60
boot_splash/show_image=false
boot_splash/bg_color=Color(0.03, 0.028, 0.026, 1)

[audio]

driver/mix_rate=48000
driver/output_latency=40

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/engine.log"
file_logging/max_log_files=6
settings/stdout/print_fps=false

[display]

window/size/viewport_width=3840
window/size/viewport_height=2160
window/size/mode=3
window/size/window_width_override=1600
window/size/window_height_override=900
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1
window/subwindows/embed_subwindows=false
window/stretch/mode="disabled"
display_server/driver.linuxbsd="wayland"
mouse_cursor/custom_image=""

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.03, 0.028, 0.026, 1)
textures/canvas_textures/default_texture_filter=1
